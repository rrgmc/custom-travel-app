{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/rrgmc/custom-travel-app/trip.schema.json",
  "title": "Trip",
  "description": "All data for one vacation. The app renders only what is in this file. See docs/data-model.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["trip", "categories", "destinations", "attractions", "reservations"],
  "definitions": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "kebab-case identifier, unique within its list"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "dateOrDateTime": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}(T([01]\\d|2[0-3]):[0-5]\\d)?$",
      "description": "YYYY-MM-DD, or YYYY-MM-DDTHH:MM as wall-clock time at the place, no offset. Example: 2026-10-10T15:00"
    },
    "timezone": {
      "type": "string",
      "description": "IANA timezone, e.g. America/Sao_Paulo",
      "pattern": "^[A-Za-z_]+(/[A-Za-z0-9_+-]+)+$|^UTC$"
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lat", "lng"],
      "properties": {
        "lat": { "type": "number", "minimum": -90, "maximum": 90 },
        "lng": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "description": "Plain text. A blank line starts a new paragraph; lines starting with '- ' form a list."
    },
    "url": { "type": "string", "pattern": "^https?://" },
    "phone": { "type": "string", "pattern": "^[+0-9][0-9 ()-]{2,}$", "description": "International format, e.g. +55 54 3286-4055, so the Call button works from any phone." }
  },
  "properties": {
    "trip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "timezone", "language"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]{1,30}$",
          "description": "Lowercase letters and digits only; becomes part of the Android app id."
        },
        "title": { "type": "string", "minLength": 1, "maxLength": 40, "description": "App name on the phone." },
        "subtitle": { "type": "string" },
        "timezone": {
          "$ref": "#/definitions/timezone",
          "description": "Default timezone for destinations and reservations that don't set their own."
        },
        "language": { "enum": ["en", "pt-BR"] },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "accent": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
        "icon": { "type": "string", "minLength": 1, "maxLength": 2, "description": "1–2 characters for the launcher icon." },
        "preferences": {
          "type": "string",
          "minLength": 1,
          "description": "Likes and dislikes that should shape research, in trip.language, e.g. 'Não gostamos de rodízio; preferimos à la carte'."
        },
        "travelers": {
          "type": "string",
          "minLength": 1,
          "description": "Who's traveling, in trip.language, with children's ages and anything that shapes the plan, e.g. '2 adultos e uma criança de 6 anos'."
        }
      }
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "description": "Attraction categories for this trip, in display order.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "name": { "type": "string", "minLength": 1 }
        }
      }
    },
    "destinations": {
      "type": "array",
      "minItems": 1,
      "description": "Cities or regions, in travel order.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "name": { "type": "string", "minLength": 1 },
          "country": { "type": "string" },
          "from": { "$ref": "#/definitions/date", "description": "First day there (optional; set together with 'to')." },
          "to": { "$ref": "#/definitions/date", "description": "Last day there." },
          "timezone": { "$ref": "#/definitions/timezone", "description": "Only when different from trip.timezone." },
          "location": { "$ref": "#/definitions/location" },
          "summary": { "$ref": "#/definitions/text", "description": "A short intro: what the place is like, why go." },
          "tips": { "$ref": "#/definitions/text", "description": "Getting around, money, safety, local customs." }
        },
        "dependencies": { "from": ["to"], "to": ["from"] }
      }
    },
    "attractions": {
      "type": "array",
      "description": "Everything worth doing or eating at each destination.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "destination", "category", "name", "priority"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "destination": { "$ref": "#/definitions/id" },
          "category": { "$ref": "#/definitions/id" },
          "name": { "type": "string", "minLength": 1 },
          "priority": {
            "enum": ["must", "want", "maybe"],
            "description": "must = must-see, want = if there's time, maybe = only if it fits."
          },
          "description": { "$ref": "#/definitions/text" },
          "tips": { "$ref": "#/definitions/text" },
          "hours": { "type": "string", "description": "Opening hours as researched, with the month checked." },
          "closed": { "type": "string", "description": "Closed days, e.g. 'Mondays'." },
          "price": { "type": "string" },
          "duration": { "type": "string", "description": "How long a visit takes, e.g. '2–3 h'." },
          "length": {
            "enum": ["quick", "hours", "half-day", "full-day"],
            "description": "Visit length at a glance: quick (under 1 h), hours (a few hours), half-day, full-day. Not for restaurants and cafés."
          },
          "rain": {
            "enum": ["indoor", "partly", "outdoor"],
            "description": "How it works in rain: indoor (covered, fine), partly (some covered parts or fine in light rain), outdoor (not worth it in rain). Not for restaurants and cafés."
          },
          "kidFriendly": { "type": "boolean", "description": "Restaurants and cafés only, when the trip has children: true when it suits them (kids' menu, play area, relaxed)." },
          "kidsNote": { "type": "string", "description": "Why it suits children, or what to know with them, e.g. 'Menu infantil e espaço kids'." },
          "rainNote": { "type": "string", "description": "What rain or fog changes here, e.g. 'Com neblina a cascata some'." },
          "town": { "type": "string", "description": "Town it's in, only when not the destination itself (a nearby town visited from there), e.g. 'Canela'." },
          "travelTime": { "type": "string", "description": "Travel time from where you stay, e.g. '20 min by car'." },
          "booking": { "type": "string", "description": "Whether and how to book ahead." },
          "address": { "type": "string" },
          "location": { "$ref": "#/definitions/location" },
          "phone": { "$ref": "#/definitions/phone" },
          "url": { "$ref": "#/definitions/url" }
        }
      }
    },
    "reservations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "title", "status"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "type": {
            "enum": ["lodging", "ticket", "flight", "train", "bus", "car-rental", "transfer", "restaurant", "other"],
            "description": "Grouped in the app as Stays (lodging), Tickets (ticket), Transport (flight, train, bus, car-rental, transfer) and Other."
          },
          "title": { "type": "string", "minLength": 1 },
          "status": { "enum": ["confirmed", "pending", "cancelled"] },
          "destination": { "$ref": "#/definitions/id", "description": "Where this reservation is used; shown on that destination's page." },
          "attraction": { "$ref": "#/definitions/id", "description": "For tickets: the attraction it gets you into." },
          "start": { "$ref": "#/definitions/dateOrDateTime", "description": "Check-in, departure, entry time. Leave out for open-dated tickets." },
          "end": { "$ref": "#/definitions/dateOrDateTime" },
          "startTimezone": { "$ref": "#/definitions/timezone" },
          "endTimezone": { "$ref": "#/definitions/timezone" },
          "from": { "type": "string", "description": "Transport: departure, e.g. 'Lisbon (LIS)'." },
          "to": { "type": "string", "description": "Transport: arrival." },
          "provider": { "type": "string" },
          "confirmation": { "type": "string", "minLength": 1 },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "value"],
              "properties": {
                "label": { "type": "string", "minLength": 1 },
                "value": { "type": "string" }
              }
            }
          },
          "payment": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status"],
            "properties": {
              "status": { "enum": ["paid", "partial", "at-location", "unpaid"] },
              "amount": { "type": "string" },
              "notes": { "type": "string" }
            }
          },
          "cancellation": { "type": "string" },
          "contact": { "$ref": "#/definitions/phone" },
          "url": { "$ref": "#/definitions/url" },
          "address": { "type": "string" },
          "location": { "$ref": "#/definitions/location" },
          "attachments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["file", "label"],
              "properties": {
                "file": { "type": "string", "pattern": "^files/[^/]+$" },
                "label": { "type": "string", "minLength": 1 },
                "preview": { "type": "string", "pattern": "^files/[^/]+\\.(png|jpg|jpeg|webp)$" }
              }
            }
          },
          "notes": { "$ref": "#/definitions/text" }
        }
      }
    },
    "dayPlans": {
      "type": "array",
      "description": "Good combinations for a day or half day at a destination: attractions that go well together (same area, one outing), with a short why. Undated: the travelers pick one on the day.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "destination", "title", "attractions"],
        "properties": {
          "id": { "$ref": "#/definitions/id" },
          "destination": { "$ref": "#/definitions/id" },
          "title": { "type": "string", "minLength": 1 },
          "length": { "enum": ["half-day", "full-day"] },
          "attractions": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/definitions/id" },
            "description": "In a sensible order, including a place to eat."
          },
          "notes": { "$ref": "#/definitions/text", "description": "Why these go together, the order, and what to check (closed days, weather, booking)." }
        }
      }
    }
  }
}
