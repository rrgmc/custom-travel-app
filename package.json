{
  "name": "custom-travel-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "validate": "node scripts/validate.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run validate && npm run icons && tsc --noEmit && vite build",
    "preview": "vite preview",
    "trip:apply": "node scripts/apply-trip-identity.mjs",
    "android:sync": "npm run build && npx cap sync android && npm run trip:apply",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/app-launcher": "^8.0.1",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capawesome-team/capacitor-file-opener": "^8.0.5",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "sharp": "^0.35.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "yaml": "^2.9.1"
  }
}
